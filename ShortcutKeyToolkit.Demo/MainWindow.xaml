<Window x:Class="ShortcutKeyToolkit.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局快捷键" Width="700" Height="550" MinWidth="610" MinHeight="430"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9" Foreground="#172033"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="添加快捷键" Click="Add_Click" Margin="0"
                    Background="#1D4ED8" Foreground="White" />
            <TextBlock Text="全局快捷键" FontSize="28" FontWeight="SemiBold" />
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Label Content="动作名称" Target="{Binding ElementName=NameInput}" Padding="0" />
                <TextBox x:Name="NameInput" Text="演示动作" Padding="6" Margin="0,6,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <CheckBox x:Name="ControlInput" Content="Ctrl" IsChecked="True" />
                    <CheckBox x:Name="AltInput" Content="Alt" />
                    <CheckBox x:Name="ShiftInput" Content="Shift" IsChecked="True" />
                    <CheckBox x:Name="WinInput" Content="Win" />
                    <Label Content="主键" Target="{Binding ElementName=KeyInput}" />
                    <ComboBox x:Name="KeyInput" Width="105" DisplayMemberPath="Label" />
                </StackPanel>
                <WrapPanel>
                    <Button x:Name="SaveButton" Content="注册快捷键" Click="Save_Click" />
                    <Button Content="检测冲突" Click="Check_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="BindingsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="BindingsGrid_SelectionChanged" Background="White" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="动作名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="快捷键" Binding="{Binding Shortcut}" Width="*" />
                <DataGridTextColumn Header="触发次数" Binding="{Binding HitCount}" Width="90" />
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="移除" Click="Remove_Click" Padding="10,3" Margin="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Text="保存后，切到其他窗口并按下组合键，观察触发次数。" />
    </Grid>
</Window>
